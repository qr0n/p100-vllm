diff --git a/csrc/libtorch_stable/pascal_host_allreduce.cu b/csrc/libtorch_stable/pascal_host_allreduce.cu
new file mode 100644
index 000000000..852c5e0c4
--- /dev/null
+++ b/csrc/libtorch_stable/pascal_host_allreduce.cu
@@ -0,0 +1,167 @@
+// SPDX-License-Identifier: Apache-2.0
+// SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+//
+// Two-rank all-reduce through mapped pinned HOST memory, for GPUs where the
+// IPC/P2P custom all-reduce is unusable (e.g. Pascal PCIe cards on different
+// CPU sockets: peer access "works" but spin-waiting across the socket link
+// hangs). Each rank streams its tensor into its own slot of a shared host
+// buffer, publishes a per-block arrival token, waits for the peer's token and
+// adds the peer's slot to its own input. For decode-sized tensors this beats
+// NCCL's ring (which also stages through host memory without P2P) because it
+// is a single kernel with no protocol overhead.
+//
+// - CUDA-graph safe: the token is a per-block counter in device memory, so no
+//   host-side argument changes between replays.
+// - Two data slots per rank (token parity): the ranks run in lockstep, so a
+//   rank can be at most one call ahead and never overwrites data its peer is
+//   still reading.
+// - Both ranks add the same two fp16 values in fp32 and round once, so the
+//   results are bit-identical across ranks.
+
+#include <cuda_bf16.h>
+#include <cuda_fp16.h>
+#include <torch/csrc/stable/library.h>
+#include <torch/headeronly/core/ScalarType.h>
+
+#include <cstdint>
+#include <string>
+#include <type_traits>
+
+#include "torch_utils.h"
+
+namespace {
+
+constexpr int kBlocks = 8;
+constexpr int kThreads = 512;
+constexpr int kFlagStrideInts = 16;  // one 64-byte line per block's arrival int
+constexpr long long kBackoffCycles = 128;
+
+template <typename T>
+__device__ __forceinline__ float to_f(T v) {
+  if constexpr (std::is_same_v<T, float>) {
+    return v;
+  } else if constexpr (std::is_same_v<T, __half>) {
+    return __half2float(v);
+  } else {
+    return __bfloat162float(v);
+  }
+}
+
+template <typename T>
+__device__ __forceinline__ T from_f(float v) {
+  if constexpr (std::is_same_v<T, float>) {
+    return v;
+  } else if constexpr (std::is_same_v<T, __half>) {
+    return __float2half_rn(v);
+  } else {
+    return __float2bfloat16_rn(v);
+  }
+}
+
+// n_vec 16-byte vectors; the host slots are laid out [slot 0 | slot 1], each
+// slot_bytes long.
+template <typename T>
+__global__ void __launch_bounds__(kThreads)
+    host_allreduce_kernel(const uint4* __restrict__ inp, uint4* __restrict__ out,
+                          int64_t n_vec, char* mine, const char* other,
+                          int* flags_mine, const int* flags_other,
+                          int* counters, int64_t slot_bytes) {
+  __shared__ int token_s;
+  const int b = blockIdx.x;
+  if (threadIdx.x == 0) token_s = counters[b] + 1;
+  __syncthreads();
+  const int token = token_s;
+  const int64_t slot_off = (token & 1) * slot_bytes;
+  uint4* my_slot = reinterpret_cast<uint4*>(mine + slot_off);
+  const uint4* peer_slot = reinterpret_cast<const uint4*>(other + slot_off);
+
+  const int64_t stride = (int64_t)gridDim.x * blockDim.x;
+  const int64_t start = (int64_t)b * blockDim.x + threadIdx.x;
+
+  // Phase 1: publish this rank's stripe.
+  for (int64_t i = start; i < n_vec; i += stride) my_slot[i] = inp[i];
+  __threadfence_system();
+  __syncthreads();
+
+  // Phase 2: signal this block's arrival, wait for the peer's matching block.
+  if (threadIdx.x == 0) {
+    *reinterpret_cast<volatile int*>(flags_mine + b * kFlagStrideInts) = token;
+    __threadfence_system();
+    const volatile int* peer_flag = flags_other + b * kFlagStrideInts;
+    while (*peer_flag != token) {
+      const long long t0 = clock64();
+      while (clock64() - t0 < kBackoffCycles) {
+      }
+    }
+    counters[b] = token;
+  }
+  __syncthreads();
+  __threadfence_system();
+
+  // Phase 3: out = mine + peer, summed in fp32 (identical on both ranks).
+  constexpr int kElems = 16 / sizeof(T);
+  for (int64_t i = start; i < n_vec; i += stride) {
+    uint4 a = inp[i];
+    // One 16-byte load that bypasses the caches (ld.global.cv): the slot is
+    // rewritten by the peer every other call.
+    const uint4 p = __ldcv(peer_slot + i);
+    const T* av = reinterpret_cast<const T*>(&a);
+    const T* pv = reinterpret_cast<const T*>(&p);
+    uint4 r;
+    T* rv = reinterpret_cast<T*>(&r);
+#pragma unroll
+    for (int k = 0; k < kElems; ++k) rv[k] = from_f<T>(to_f(av[k]) + to_f(pv[k]));
+    out[i] = r;
+  }
+}
+
+void pascal_host_allreduce(const torch::stable::Tensor& inp,
+                           torch::stable::Tensor& out, int64_t mine,
+                           int64_t other, int64_t flags_mine,
+                           int64_t flags_other, torch::stable::Tensor& counters,
+                           int64_t slot_bytes) {
+  const int64_t nbytes = inp.numel() * inp.element_size();
+  STD_TORCH_CHECK(nbytes % 16 == 0 && nbytes <= slot_bytes,
+                  "pascal_host_allreduce: size must be a multiple of 16 bytes "
+                  "and fit one slot");
+  STD_TORCH_CHECK(counters.numel() >= kBlocks,
+                  "pascal_host_allreduce: counters too small");
+  const int64_t n_vec = nbytes / 16;
+  cudaStream_t stream = get_current_cuda_stream();
+  auto launch = [&]<typename T>() {
+    host_allreduce_kernel<T><<<kBlocks, kThreads, 0, stream>>>(
+        reinterpret_cast<const uint4*>(inp.data_ptr()),
+        reinterpret_cast<uint4*>(out.mutable_data_ptr()), n_vec,
+        reinterpret_cast<char*>(mine), reinterpret_cast<const char*>(other),
+        reinterpret_cast<int*>(flags_mine),
+        reinterpret_cast<const int*>(flags_other),
+        counters.mutable_data_ptr<int32_t>(), slot_bytes);
+  };
+  const auto dt = inp.scalar_type();
+  if (dt == torch::headeronly::ScalarType::Half) {
+    launch.operator()<__half>();
+  } else if (dt == torch::headeronly::ScalarType::BFloat16) {
+    launch.operator()<__nv_bfloat16>();
+  } else {
+    STD_TORCH_CHECK(dt == torch::headeronly::ScalarType::Float,
+                    "pascal_host_allreduce: unsupported dtype");
+    launch.operator()<float>();
+  }
+  const cudaError_t err = cudaGetLastError();
+  STD_TORCH_CHECK(err == cudaSuccess, std::string("pascal_host_allreduce: ") +
+                                          cudaGetErrorString(err));
+}
+
+}  // namespace
+
+STABLE_TORCH_LIBRARY_FRAGMENT(_C, pascal_host_allreduce_ops) {
+  pascal_host_allreduce_ops.def(
+      "pascal_host_allreduce(Tensor inp, Tensor! out, int mine, int other, "
+      "int flags_mine, int flags_other, Tensor! counters, int slot_bytes) "
+      "-> ()");
+}
+
+STABLE_TORCH_LIBRARY_IMPL(_C, CUDA, pascal_host_allreduce_ops) {
+  pascal_host_allreduce_ops.impl("pascal_host_allreduce",
+                                 TORCH_BOX(&pascal_host_allreduce));
+}
