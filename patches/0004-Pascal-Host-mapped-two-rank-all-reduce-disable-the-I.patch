--- /dev/null
+++ b/vllm/distributed/device_communicators/pascal_host_all_reduce.py
@@ -0,0 +1,117 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Two-rank all-reduce through mapped pinned host memory (pre-Volta GPUs).
+
+vLLM's IPC custom all-reduce spin-waits on flags in the peer GPU's memory. On
+Pascal PCIe cards behind different CPU sockets, peer access reports as
+available but those spins never complete, so the engine hangs. NCCL works but
+costs ~33 us per decode-sized all-reduce (this: ~19.5 us). This backend has each rank
+write its tensor into a POSIX shared-memory buffer that both worker processes
+register with ``cudaHostRegister`` (mapped), exchange per-block arrival tokens
+there, and add the peer's copy on the GPU: one kernel, graph-capturable.
+See csrc/libtorch_stable/pascal_host_allreduce.cu for the protocol.
+"""
+
+import ctypes
+import uuid
+from multiprocessing import shared_memory
+
+import torch
+import torch.distributed as dist
+from torch.distributed import ProcessGroup
+
+from vllm.logger import init_logger
+
+logger = init_logger(__name__)
+
+_BLOCKS = 8  # must match kBlocks in pascal_host_allreduce.cu
+_FLAG_BYTES = _BLOCKS * 64
+_CUDA_HOST_REGISTER_PORTABLE = 1
+_CUDA_HOST_REGISTER_MAPPED = 2
+
+
+class PascalHostAllreduce:
+    def __init__(
+        self, group: ProcessGroup, device: torch.device, max_bytes: int = 1 << 20
+    ):
+        self.disabled = True
+        self.group = group
+        self.rank = dist.get_rank(group)
+        self.world_size = dist.get_world_size(group)
+        if self.world_size != 2:
+            return
+        self.max_bytes = max_bytes
+        # Per rank: [flags | slot 0 | slot 1].
+        self.rank_bytes = _FLAG_BYTES + 2 * max_bytes
+        total = 2 * self.rank_bytes
+
+        name = [f"vllm_pascal_ar_{uuid.uuid4().hex[:16]}" if self.rank == 0 else None]
+        if self.rank == 0:
+            self._shm = shared_memory.SharedMemory(name=name[0], create=True, size=total)
+            ctypes.memset(self._addr(), 0, total)
+        dist.broadcast_object_list(name, src=dist.get_global_rank(group, 0), group=group)
+        if self.rank != 0:
+            self._shm = shared_memory.SharedMemory(name=name[0])
+        dist.barrier(group=group)
+        if self.rank == 0:
+            # Both ranks have it mapped; drop the name so it cannot leak.
+            self._shm.unlink()
+
+        base = self._addr()
+        err = torch.cuda.cudart().cudaHostRegister(
+            base, total, _CUDA_HOST_REGISTER_PORTABLE | _CUDA_HOST_REGISTER_MAPPED
+        )
+        if int(err) != 0:
+            logger.warning("PascalHostAllreduce: cudaHostRegister failed (%s)", err)
+            return
+        self._registered = base
+        # With unified addressing the registered host pointer is also the
+        # device pointer.
+        mine = base + self.rank * self.rank_bytes
+        other = base + (1 - self.rank) * self.rank_bytes
+        self.flags_mine, self.flags_other = mine, other
+        self.data_mine, self.data_other = mine + _FLAG_BYTES, other + _FLAG_BYTES
+        self.counters = torch.zeros(_BLOCKS, dtype=torch.int32, device=device)
+        dist.barrier(group=group)
+        self.disabled = False
+        logger.info(
+            "PascalHostAllreduce enabled (host-mapped, up to %d bytes per call).",
+            max_bytes,
+        )
+
+    def _addr(self) -> int:
+        if getattr(self, "_cbuf", None) is None:
+            self._cbuf = ctypes.c_char.from_buffer(self._shm.buf)
+        return ctypes.addressof(self._cbuf)
+
+    def should_use(self, inp: torch.Tensor) -> bool:
+        if self.disabled:
+            return False
+        nbytes = inp.numel() * inp.element_size()
+        return (
+            inp.is_contiguous()
+            and inp.dtype in (torch.float16, torch.bfloat16, torch.float32)
+            and nbytes % 16 == 0
+            and 0 < nbytes <= self.max_bytes
+        )
+
+    def all_reduce(self, inp: torch.Tensor) -> torch.Tensor:
+        out = torch.empty_like(inp)
+        torch.ops._C.pascal_host_allreduce(
+            inp, out, self.data_mine, self.data_other, self.flags_mine,
+            self.flags_other, self.counters, self.max_bytes,
+        )
+        return out
+
+    def close(self) -> None:
+        if getattr(self, "_registered", None):
+            torch.cuda.cudart().cudaHostUnregister(self._registered)
+            self._registered = None
+        self._cbuf = None  # release the buffer export before closing
+        shm = getattr(self, "_shm", None)
+        if shm is not None:
+            shm.close()
+            self._shm = None
+
+    def __del__(self):
+        self.close()
