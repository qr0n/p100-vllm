+// Pascal (sm_60) variant of the 4-bit kernel above, used for small M. Same
+// grid, block, layout and split-K atomics; different inner loop:
+//  - nibbles are masked straight into SUBNORMAL fp16 bit patterns
+//    (q * 2^-24, exact; HFMA2 is full rate on subnormals on sm_60) instead of
+//    the bias-OR + subtract/scale dequant: 5 instead of ~9 ops per word;
+//  - the 16x factor of the odd nibble pair is folded into the shared copy of
+//    the activations, which is also pre-scaled per 128-row slice by 2^e so
+//    the products land in normal fp16 range;
+//  - the zero point comes off once per 32 rows in fp32 with the activation
+//    sum, and fp16 partials are flushed to fp32 once per 32 rows, not per 8.
+template <bool first_block, int m_count>
+__global__ void __launch_bounds__(BLOCK_KN_SIZE)
+    gemm_half_q_half_gptq_4bit_kernel_sm60(
+        const half* __restrict__ a, const uint32_t* __restrict__ b_q_weight,
+        const uint32_t* __restrict__ b_gptq_qzeros,
+        const half* __restrict__ b_gptq_scales, half* __restrict__ c,
+        const int size_m, const int size_n, const int size_k, const int groups,
+        const bool use_v2_format) {
+  MatrixView_half a_(a, size_m, size_k);
+  MatrixView_half_rw c_(c, size_m, size_n);
+  MatrixView_q4_row b_gptq_qzeros_(b_gptq_qzeros, groups, size_n);
+  MatrixView_half b_gptq_scales_(b_gptq_scales, groups, size_n);
+  const int zero_offset = use_v2_format ? 0 : 1;
+
+  const int t = threadIdx.x;
+  const int lane = t & 31, warp = t >> 5;
+  const int offset_n = blockIdx.x * BLOCK_KN_SIZE * 4;
+  const int offset_m = blockIdx.y * m_count;
+  const int offset_k = blockIdx.z * BLOCK_KN_SIZE;
+  const int end_k = min(offset_k + BLOCK_KN_SIZE, size_k);
+  const int n = offset_n + t * 4;
+
+  __shared__ half block_a[m_count][BLOCK_KN_SIZE];
+  __shared__ float amax_w[m_count][BLOCK_KN_SIZE / 32];
+  __shared__ float asum_w[m_count][BLOCK_KN_SIZE / 32];  // per 32-row step
+  __shared__ float inv_s[m_count];
+
+  float av[m_count];
+#pragma unroll
+  for (int m = 0; m < m_count; ++m) {
+    av[m] = offset_k + t < end_k ? __half2float(*a_.item_ptr(offset_m + m, offset_k + t))
+                                 : 0.f;
+    float mx = fabsf(av[m]), sm = av[m];
+#pragma unroll
+    for (int o = 16; o > 0; o >>= 1) {
+      mx = fmaxf(mx, __shfl_xor_sync(0xffffffffu, mx, o));
+      sm += __shfl_xor_sync(0xffffffffu, sm, o);
+    }
+    if (lane == 0) {
+      amax_w[m][warp] = mx;
+      asum_w[m][warp] = sm;
+    }
+  }
+  __syncthreads();
+#pragma unroll
+  for (int m = 0; m < m_count; ++m) {
+    float mx = 0.f;
+#pragma unroll
+    for (int w = 0; w < BLOCK_KN_SIZE / 32; ++w) mx = fmaxf(mx, amax_w[m][w]);
+    int e = 0;
+    if (mx > 0.f) {
+      int ex;
+      frexpf(mx, &ex);  // mx < 2^ex, so |a| * 2^(14 - ex) < 2^14
+      e = 14 - ex;
+    }
+    const int pos = t & 7;  // rows 2,3,6,7 of each word pair with 16*q
+    const float sc = ldexpf(1.f, e) * ((pos & 2) ? 0.0625f : 1.f);
+    block_a[m][t] = __float2half_rn(av[m] * sc);
+    if (t == 0) inv_s[m] = ldexpf(1.f, 24 - e);
+  }
+  __syncthreads();
+  if (n >= size_n) return;
+
+  const int groupsize = size_k / groups;
+  int group = offset_k / groupsize;
+  int nextgroup = offset_k + groupsize;
+  const uint32_t* b_ptr = b_q_weight + (offset_k / 8) * size_n + n;
+
+  int zeros[4];
+  float scales[4], zf[4];
+  b_gptq_qzeros_.item4(zeros, group, n);
+  b_gptq_scales_.item4_f(scales, group, n);
+#pragma unroll
+  for (int i = 0; i < 4; ++i) zf[i] = (float)(zeros[i] + zero_offset);
+
+  float block_c[m_count][4] = {};
+  int step = 0;
+  for (int k = offset_k; k < end_k; k += 32, ++step) {
+    if (k == nextgroup) {
+      group++;
+      nextgroup += groupsize;
+      b_gptq_qzeros_.item4(zeros, group, n);
+      b_gptq_scales_.item4_f(scales, group, n);
+#pragma unroll
+      for (int i = 0; i < 4; ++i) zf[i] = (float)(zeros[i] + zero_offset);
+    }
+    half2 hacc[m_count][4];
+#pragma unroll
+    for (int m = 0; m < m_count; ++m)
+#pragma unroll
+      for (int i = 0; i < 4; ++i) hacc[m][i] = __float2half2_rn(0.f);
+#pragma unroll
+    for (int j = 0; j < 4; ++j) {
+      const int4 w4 = *reinterpret_cast<const int4*>(b_ptr);
+      const uint32_t wv[4] = {(uint32_t)w4.x, (uint32_t)w4.y, (uint32_t)w4.z,
+                              (uint32_t)w4.w};
+      uint32_t d[4][4];
+#pragma unroll
+      for (int i = 0; i < 4; ++i) {
+        const uint32_t w0 = wv[i], w1 = w0 >> 8;
+        d[i][0] = w0 & 0x000f000fu;
+        d[i][1] = w0 & 0x00f000f0u;
+        d[i][2] = w1 & 0x000f000fu;
+        d[i][3] = w1 & 0x00f000f0u;
+      }
+#pragma unroll
+      for (int m = 0; m < m_count; ++m) {
+        const half2* ap = reinterpret_cast<const half2*>(block_a[m]) + (step * 32 + j * 8) / 2;
+        const half2 x0 = ap[0], x1 = ap[1], x2 = ap[2], x3 = ap[3];
+#pragma unroll
+        for (int i = 0; i < 4; ++i) {
+          hacc[m][i] = __hfma2(*reinterpret_cast<const half2*>(&d[i][0]), x0, hacc[m][i]);
+          hacc[m][i] = __hfma2(*reinterpret_cast<const half2*>(&d[i][1]), x1, hacc[m][i]);
+          hacc[m][i] = __hfma2(*reinterpret_cast<const half2*>(&d[i][2]), x2, hacc[m][i]);
+          hacc[m][i] = __hfma2(*reinterpret_cast<const half2*>(&d[i][3]), x3, hacc[m][i]);
+        }
+      }
+      b_ptr += size_n;
+    }
+#pragma unroll
+    for (int m = 0; m < m_count; ++m) {
+      const float inv = inv_s[m], as = asum_w[m][step];
+#pragma unroll
+      for (int i = 0; i < 4; ++i) {
+        const float2 f = __half22float2(hacc[m][i]);
+        block_c[m][i] = fmaf(scales[i], fmaf(f.x + f.y, inv, -zf[i] * as), block_c[m][i]);
+      }
+    }
+  }
+
+  for (int m = 0; m < m_count; m++) {
+    half2* out = (half2*)c_.item_ptr(offset_m + m, n);
+    half2 result01 = __halves2half2(__float2half_rn(block_c[m][0]),
+                                    __float2half_rn(block_c[m][1]));
+    half2 result23 = __halves2half2(__float2half_rn(block_c[m][2]),
+                                    __float2half_rn(block_c[m][3]));
+    atomicAdd(out, result01);
+    atomicAdd(out + 1, result23);
+  }
+}
+
 template <bool first_block, int m_count>
 __global__ void gemm_half_q_half_gptq_2bit_kernel(
     const half* __restrict__ a, const uint32_t* __restrict__ b_q_weight,
@@ -634,6 +818,20 @@ fp_gemm_half_q_half_gptq_kernel pick_gemm_half_q_half_gptq_kernel(
   return NULL;
 }
 
+// The subnormal-HFMA2 variant is tuned for (and only measured on) sm_60.
+// VLLM_GPTQ_SM60_KERNEL=0 turns it off.
+static bool gptq_use_sm60_kernel() {
+  static const bool use = [] {
+    const char* env = std::getenv("VLLM_GPTQ_SM60_KERNEL");
+    if (env && env[0] == '0') return false;
+    int dev = 0, major = 0;
+    cudaGetDevice(&dev);
+    cudaDeviceGetAttribute(&major, cudaDevAttrComputeCapabilityMajor, dev);
+    return major < 7;
+  }();
+  return use;
+}
+
 void gemm_half_q_half_cuda_part(const half* a, const uint32_t* b_q_weight,
                                 const uint32_t* b_gptq_qzeros,
                                 const half* b_gptq_scales, half* c, int size_m,
@@ -649,6 +847,18 @@ void gemm_half_q_half_cuda_part(const half* a, const uint32_t* b_q_weight,
 
   fp_gemm_half_q_half_gptq_kernel kernel =
       pick_gemm_half_q_half_gptq_kernel(true, m_count, bit);
+  if (bit == 4 && gptq_use_sm60_kernel()) {
+    switch (m_count) {
+      case 1: kernel = gemm_half_q_half_gptq_4bit_kernel_sm60<true, 1>; break;
+      case 2: kernel = gemm_half_q_half_gptq_4bit_kernel_sm60<true, 2>; break;
+      case 3: kernel = gemm_half_q_half_gptq_4bit_kernel_sm60<true, 3>; break;
+      case 4: kernel = gemm_half_q_half_gptq_4bit_kernel_sm60<true, 4>; break;
+      case 5: kernel = gemm_half_q_half_gptq_4bit_kernel_sm60<true, 5>; break;
+      case 6: kernel = gemm_half_q_half_gptq_4bit_kernel_sm60<true, 6>; break;
+      case 7: kernel = gemm_half_q_half_gptq_4bit_kernel_sm60<true, 7>; break;
+      case 8: kernel = gemm_half_q_half_gptq_4bit_kernel_sm60<true, 8>; break;
+    }
+  }
 
   const cudaStream_t stream = get_current_cuda_stream();
   kernel<<<gridDim, blockDim, 0, stream>>>(a, b_q_weight, b_gptq_qzeros,
